# Supabase PostgreSQL Database Connection Strings
# (Make sure to replace with your own database connection parameters)
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres"

# JWT Authentication Session Secret
# (Generate a secure random key using: openssl rand -base64 32)
JWT_SECRET="generate-a-secure-random-jwt-key-here-for-production"

# Next.js Application URL
# (Use http://localhost:3000 for local development, and your live domain for production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Model API Credentials
# Gemini API Key (Supports comma-separated keys for auto-rotation and rate-limit fallbacks)
GEMINI_API_KEY="your-gemini-api-key-here"

# OpenAI API Key (Optional fallback if Gemini keys are rate-limited or fail)
OPENAI_API_KEY="your-openai-api-key-here"
